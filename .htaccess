Options -Indexes -MultiViews +FollowSymLinks
RewriteEngine On

# Jika request sudah menuju folder backend/public, biarkan (hindari infinite loop)
RewriteCond %{REQUEST_URI} ^/backend/public/ [OR]
RewriteCond %{REQUEST_URI} ^/backend/public$
RewriteRule ^ - [L]

# Rewrite semua request ke folder backend/public
RewriteCond %{REQUEST_URI} !^/backend/public/
RewriteRule ^(.*)$ backend/public/$1 [L]
